<?xml version="1.0" encoding="UTF-8"?>
<!--
  GZAC pushes the contracts it bound for a plugin configuration
  (grantedContracts). The app keeps them to tell an unbound Open Plan
  contract apart from an unreachable GZAC.
-->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="010-01-plugin-configuration-granted-contracts" author="pdca">
        <addColumn tableName="plugin_configuration">
            <column name="granted_contracts" type="TEXT" defaultValue="[]">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
