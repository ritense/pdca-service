{
    "pluginHost": {
        "baseUrl": "http://localhost:8090",
        "configurations": [
            {
                "pluginId": "openplan",
                "title": "Open Plan (PDCA dev)",
                "properties": {
                    "openPlanUrl": "${PDCA_OPENPLAN_URL:http://host.docker.internal:7501}",
                    "openPlanToken": "${PDCA_OPENPLAN_TOKEN:pdca-openplan-dev-token-0123456789abcdef}"
                },
                "grantedCapabilities": ["http_request", "log"]
            },
            {
                "pluginId": "openproduct",
                "title": "Open Product (PDCA dev)",
                "properties": {
                    "openProductUrl": "${PDCA_OPENPRODUCT_URL:http://host.docker.internal:7502}",
                    "openProductToken": "${PDCA_OPENPRODUCT_TOKEN:pdca-openproduct-dev-token-0123456789abc}"
                },
                "grantedCapabilities": ["http_request", "log"]
            },
            {
                "pluginId": "openklant",
                "title": "Open Klant (PDCA dev)",
                "properties": {
                    "openKlantUrl": "${PDCA_OPENKLANT_URL:http://host.docker.internal:7504}",
                    "openKlantToken": "${PDCA_OPENKLANT_TOKEN:pdca-openklant-dev-token-0123456789abcde}"
                },
                "grantedCapabilities": ["http_request", "log"]
            },
            {
                "pluginId": "objecten",
                "title": "Objecten API (PDCA dev)",
                "properties": {
                    "objectenUrl": "${PDCA_OBJECTEN_URL:http://host.docker.internal:8010}",
                    "objectenToken": "${VALTIMO_OBJECTEN_API_TOKEN:182c13e2209161852c53cef53a879f7a2f923430}",
                    "verzoekObjecttypeUrl": "${PDCA_VERZOEK_OBJECTTYPE_URL:http://host.docker.internal:8011/api/v2/objecttypes/00000000-0000-4000-8000-0000dca00001}"
                },
                "grantedCapabilities": ["http_request", "log"]
            }
        ]
    },
    "app": {
        "name": "PDCA Planbeheer",
        "baseUrl": "${PDCA_APP_URL:http://localhost:7500}",
        "secret": "${PDCA_HOST_SECRET:dev-only-insecure-secret}",
        "gzacCallbackBaseUrl": "${PDCA_GZAC_CALLBACK_URL:http://localhost:8080}",
        "frontendOrigins": ["http://localhost:4200"],
        "configuration": {
            "title": "PDCA Planbeheer",
            "pluginId": "pdca",
            "pluginVersion": "0.2.0",
            "properties": {},
            "grantedCapabilities": ["gzac_api", "frontend_data"],
            "grantedEndpoints": [
                {"method": "POST", "pattern": "/api/v1/process-document/operation/new-document-and-start-process"},
                {"method": "GET", "pattern": "/api/v1/document-definition/*"},
                {"method": "GET", "pattern": "/api/management/v1/document-definition"},
                {"method": "GET", "pattern": "/api/v1/document/*"},
                {"method": "GET", "pattern": "/api/management/v1/case/*"},
                {"method": "POST", "pattern": "/api/v1/document-search"}
            ],
            "contractBindings": [
                {"contract": "nl.ritense.openplan@2", "pluginId": "openplan"},
                {"contract": "nl.ritense.openproduct@2", "pluginId": "openproduct"},
                {"contract": "nl.ritense.openklant@2", "pluginId": "openklant"},
                {"contract": "nl.ritense.objecten@2", "pluginId": "objecten"}
            ]
        }
    },
    "caseDefinitions": {
        "placeholderConfigurationId": "00000000-0000-4000-8000-00000000dca0",
        "zips": ["inwonerplan", "binnenhof-renovatie", "intake-werk-participatie", "renovatie-intake", "instrument-verzoek"]
    },
    "verzoek": {
        "notificatiesApiCallbackUrl": "${PDCA_GZAC_NOTIFICATIES_CALLBACK_URL:http://host.docker.internal:8080/api/v1/notificatiesapi/callback}",
        "objecttypenApi": {
            "id": "00000000-0000-4000-8000-0000dca00004",
            "title": "Objecttypen API (PDCA dev)",
            "url": "${PDCA_VERZOEK_OBJECTTYPEN_API_URL:http://host.docker.internal:8011/api/v2/}"
        },
        "objectManagement": {
            "id": "00000000-0000-4000-8000-0000dca00002",
            "title": "InstrumentVerzoek",
            "objecttypeId": "00000000-0000-4000-8000-0000dca00001",
            "objecttypeVersion": 1,
            "showInDataMenu": true
        },
        "plugin": {
            "id": "00000000-0000-4000-8000-0000dca00003",
            "title": "Verzoek instrument (PDCA)",
            "processToStart": "instrument-verzoek",
            "rsin": "${PDCA_VERZOEK_RSIN:051845623}",
            "verzoekProperties": [
                {
                    "type": "instrument",
                    "caseDefinitionKey": "instrument-verzoek",
                    "processDefinitionKey": "instrument-verzoek",
                    "initiatorRoltypeUuid": "${PDCA_VERZOEK_INITIATOR_ROLTYPE_UUID:1c359a1b-c38d-47b8-bed5-994db88ead61}",
                    "initiatorRolDescription": "Initiator",
                    "copyStrategy": "full"
                }
            ]
        },
        "zaakTypeLink": {
            "caseDefinitionKey": "instrument-verzoek",
            "zaaktypeUuid": "${PDCA_VERZOEK_ZAAKTYPE_UUID:744ca059-f412-49d4-8963-5800e4afd486}",
            "createWithDossier": false,
            "rsin": "000000000"
        }
    }
}
