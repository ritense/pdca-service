<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_intake_werk_participatie"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="pdca-app" exporterVersion="0.1.0">
    <bpmn:process camunda:versionTag="CD:intake-werk-participatie:1.0.0" id="intake-werk-participatie" isExecutable="true"
                  name="Intake werk en participatie">
        <bpmn:startEvent id="start-event" name="Aanmelding">
            <bpmn:outgoing>flow-start-status-intake</bpmn:outgoing>
        </bpmn:startEvent>
        <!-- The "Fase: ..." service tasks set the internal case status per intake
             phase (documentDelegateService.setInternalStatus). The status history
             feeds the metroline widget on the Samenvatting widget tab and the
             per-phase displayConditions key off case:internalStatus. -->
        <bpmn:serviceTask camunda:asyncBefore="true" id="status-intakegesprek" name="Fase: Intakegesprek"
                          camunda:expression="${documentDelegateService.setInternalStatus(execution, 'intakegesprek')}">
            <bpmn:incoming>flow-start-status-intake</bpmn:incoming>
            <bpmn:outgoing>flow-status-intake-intakegesprek</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:userTask camunda:candidateGroups="ROLE_USER" id="intakegesprek" name="Intakegesprek voeren">
            <bpmn:documentation>Leg het intakegesprek vast: de DVKM-vragen (inwonergegevens, in het dossier
                onder dvkm*), betrokkenen en een gespreksnotitie.
            </bpmn:documentation>
            <bpmn:incoming>flow-status-intake-intakegesprek</bpmn:incoming>
            <bpmn:outgoing>flow-intakegesprek-status-positie</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:serviceTask camunda:asyncBefore="true" id="status-positie-bepalen" name="Fase: Inwonerpositie bepalen"
                          camunda:expression="${documentDelegateService.setInternalStatus(execution, 'positie-bepalen')}">
            <bpmn:incoming>flow-intakegesprek-status-positie</bpmn:incoming>
            <bpmn:outgoing>flow-status-positie-bepalen</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:businessRuleTask camunda:asyncBefore="true" camunda:decisionRef="dvkm-inwonerpositie"
                               camunda:mapDecisionResult="singleResult" camunda:resultVariable="dvkmAdvies"
                               id="inwonerpositie-bepalen" name="Inwonerpositie bepalen (DVKM)">
            <bpmn:documentation>Mock van het DVKM-algoritme als DRD met twee tabellen: 'dvkm-subdoelgroep'
                (de ruleset) bepaalt uit de inwonergegevens de subdoelgroep; de toptabel
                'dvkm-inwonerpositie' (de subdoelgroep-catalogus) vertaalt die naar de inwonerpositie en
                het gekoppelde hoofddoel. De inwonergegevens staan in het dossier (dvkm*) en worden via
                de inputmapping als taaklokale variabelen aan de beslistabellen aangeboden, zodat ze na
                het proces beschikbaar blijven voor de widgets. Het resultaat (dvkmAdvies, lokale map)
                wordt via de outputmapping platgeslagen naar drie procesvariabelen:
                inwonerpositieAdvies, subdoelgroepAdvies en hoofddoelAdvies. De behandelaar neemt het
                advies in het vervolggesprek over of wijkt beargumenteerd af.
            </bpmn:documentation>
            <bpmn:extensionElements>
                <camunda:inputOutput>
                    <camunda:inputParameter name="dvkmWerk">${documentDelegateService.findValueByJsonPointerOrDefault('/dvkmWerk', execution, '')}</camunda:inputParameter>
                    <camunda:inputParameter name="dvkmAcuut">${documentDelegateService.findValueByJsonPointerOrDefault('/dvkmAcuut', execution, '')}</camunda:inputParameter>
                    <camunda:inputParameter name="dvkmOntheffing">${documentDelegateService.findValueByJsonPointerOrDefault('/dvkmOntheffing', execution, '')}</camunda:inputParameter>
                    <camunda:inputParameter name="dvkmZrm">${documentDelegateService.findValueByJsonPointerOrDefault('/dvkmZrm', execution, '')}</camunda:inputParameter>
                    <camunda:inputParameter name="dvkmDienstverband">${documentDelegateService.findValueByJsonPointerOrDefault('/dvkmDienstverband', execution, '')}</camunda:inputParameter>
                    <camunda:inputParameter name="dvkmWerknemersvaardigheden">${documentDelegateService.findValueByJsonPointerOrDefault('/dvkmWerknemersvaardigheden', execution, '')}</camunda:inputParameter>
                    <camunda:inputParameter name="dvkmTaalniveau">${documentDelegateService.findValueByJsonPointerOrDefault('/dvkmTaalniveau', execution, '')}</camunda:inputParameter>
                    <camunda:inputParameter name="dvkmMotivatie">${documentDelegateService.findValueByJsonPointerOrDefault('/dvkmMotivatie', execution, '')}</camunda:inputParameter>
                    <camunda:outputParameter name="inwonerpositieAdvies">${dvkmAdvies.inwonerpositie}</camunda:outputParameter>
                    <camunda:outputParameter name="subdoelgroepAdvies">${dvkmAdvies.subdoelgroep}</camunda:outputParameter>
                    <camunda:outputParameter name="hoofddoelAdvies">${dvkmAdvies.hoofddoel}</camunda:outputParameter>
                </camunda:inputOutput>
            </bpmn:extensionElements>
            <bpmn:incoming>flow-status-positie-bepalen</bpmn:incoming>
            <bpmn:outgoing>flow-positie-status-vervolg</bpmn:outgoing>
        </bpmn:businessRuleTask>
        <bpmn:serviceTask camunda:asyncBefore="true" id="status-vervolggesprek" name="Fase: Vervolggesprek"
                          camunda:expression="${documentDelegateService.setInternalStatus(execution, 'vervolggesprek')}">
            <bpmn:incoming>flow-positie-status-vervolg</bpmn:incoming>
            <bpmn:outgoing>flow-status-vervolg-vervolggesprek</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:userTask camunda:candidateGroups="ROLE_USER" id="vervolggesprek"
                       name="Vervolggesprek: positie, doelen en aanpak">
            <bpmn:documentation>Bespreek het DVKM-advies met de inwoner (overnemen of beargumenteerd
                afwijken) en werk hoofddoel, positie, doelen en beoogde inzet uit.
            </bpmn:documentation>
            <bpmn:incoming>flow-status-vervolg-vervolggesprek</bpmn:incoming>
            <bpmn:outgoing>flow-vervolg-status-plan</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:serviceTask camunda:asyncBefore="true" id="status-plan-aanmaken" name="Fase: Plan aanmaken"
                          camunda:expression="${documentDelegateService.setInternalStatus(execution, 'plan-aanmaken')}">
            <bpmn:incoming>flow-vervolg-status-plan</bpmn:incoming>
            <bpmn:outgoing>flow-status-plan-plan-aanmaken</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:userTask camunda:candidateGroups="ROLE_USER" id="plan-aanmaken" name="Plan aanmaken (PDCA)">
            <bpmn:documentation>Maak het plan aan op basis van de intake in dit dossier, via het externe
                taakformulier "create-plan" van de PDCA-app. De proceskoppeling zit in de zip: kies bij de
                import de PDCA-pluginconfiguratie, of herstel de koppeling daarna via de configuratiemelding
                op het dossiertype. Het formulier wordt voorgevuld vanuit de dossier-content en maakt naast
                het plan ook het bijbehorende plan-dossier aan.
            </bpmn:documentation>
            <bpmn:incoming>flow-status-plan-plan-aanmaken</bpmn:incoming>
            <bpmn:outgoing>flow-plan-aanmaken-status-afgerond</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:serviceTask camunda:asyncBefore="true" id="status-afgerond" name="Fase: Intake afgerond"
                          camunda:expression="${documentDelegateService.setInternalStatus(execution, 'afgerond')}">
            <bpmn:incoming>flow-plan-aanmaken-status-afgerond</bpmn:incoming>
            <bpmn:outgoing>flow-status-afgerond-einde</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:endEvent id="einde" name="Intake afgerond">
            <bpmn:incoming>flow-status-afgerond-einde</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="flow-start-status-intake" sourceRef="start-event" targetRef="status-intakegesprek"/>
        <bpmn:sequenceFlow id="flow-status-intake-intakegesprek" sourceRef="status-intakegesprek"
                           targetRef="intakegesprek"/>
        <bpmn:sequenceFlow id="flow-intakegesprek-status-positie" sourceRef="intakegesprek"
                           targetRef="status-positie-bepalen"/>
        <bpmn:sequenceFlow id="flow-status-positie-bepalen" sourceRef="status-positie-bepalen"
                           targetRef="inwonerpositie-bepalen"/>
        <bpmn:sequenceFlow id="flow-positie-status-vervolg" sourceRef="inwonerpositie-bepalen"
                           targetRef="status-vervolggesprek"/>
        <bpmn:sequenceFlow id="flow-status-vervolg-vervolggesprek" sourceRef="status-vervolggesprek"
                           targetRef="vervolggesprek"/>
        <bpmn:sequenceFlow id="flow-vervolg-status-plan" sourceRef="vervolggesprek"
                           targetRef="status-plan-aanmaken"/>
        <bpmn:sequenceFlow id="flow-status-plan-plan-aanmaken" sourceRef="status-plan-aanmaken"
                           targetRef="plan-aanmaken"/>
        <bpmn:sequenceFlow id="flow-plan-aanmaken-status-afgerond" sourceRef="plan-aanmaken"
                           targetRef="status-afgerond"/>
        <bpmn:sequenceFlow id="flow-status-afgerond-einde" sourceRef="status-afgerond" targetRef="einde"/>
    </bpmn:process>
    <bpmndi:BPMNDiagram id="BPMNDiagram_intake_werk_participatie">
        <bpmndi:BPMNPlane bpmnElement="intake-werk-participatie" id="BPMNPlane_intake_werk_participatie">
            <bpmndi:BPMNShape bpmnElement="start-event" id="Shape_start-event">
                <dc:Bounds height="36" width="36" x="152" y="152"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape bpmnElement="status-intakegesprek" id="Shape_status-intakegesprek">
                <dc:Bounds height="80" width="100" x="240" y="130"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape bpmnElement="intakegesprek" id="Shape_intakegesprek">
                <dc:Bounds height="80" width="100" x="390" y="130"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape bpmnElement="status-positie-bepalen" id="Shape_status-positie-bepalen">
                <dc:Bounds height="80" width="100" x="540" y="130"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape bpmnElement="inwonerpositie-bepalen" id="Shape_inwonerpositie-bepalen">
                <dc:Bounds height="80" width="100" x="690" y="130"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape bpmnElement="status-vervolggesprek" id="Shape_status-vervolggesprek">
                <dc:Bounds height="80" width="100" x="840" y="130"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape bpmnElement="vervolggesprek" id="Shape_vervolggesprek">
                <dc:Bounds height="80" width="100" x="990" y="130"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape bpmnElement="status-plan-aanmaken" id="Shape_status-plan-aanmaken">
                <dc:Bounds height="80" width="100" x="1140" y="130"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape bpmnElement="plan-aanmaken" id="Shape_plan-aanmaken">
                <dc:Bounds height="80" width="100" x="1290" y="130"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape bpmnElement="status-afgerond" id="Shape_status-afgerond">
                <dc:Bounds height="80" width="100" x="1440" y="130"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape bpmnElement="einde" id="Shape_einde">
                <dc:Bounds height="36" width="36" x="1590" y="152"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNEdge bpmnElement="flow-start-status-intake" id="Edge_flow-start-status-intake">
                <di:waypoint x="188" y="170"/>
                <di:waypoint x="240" y="170"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="flow-status-intake-intakegesprek" id="Edge_flow-status-intake-intakegesprek">
                <di:waypoint x="340" y="170"/>
                <di:waypoint x="390" y="170"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="flow-intakegesprek-status-positie"
                             id="Edge_flow-intakegesprek-status-positie">
                <di:waypoint x="490" y="170"/>
                <di:waypoint x="540" y="170"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="flow-status-positie-bepalen" id="Edge_flow-status-positie-bepalen">
                <di:waypoint x="640" y="170"/>
                <di:waypoint x="690" y="170"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="flow-positie-status-vervolg" id="Edge_flow-positie-status-vervolg">
                <di:waypoint x="790" y="170"/>
                <di:waypoint x="840" y="170"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="flow-status-vervolg-vervolggesprek"
                             id="Edge_flow-status-vervolg-vervolggesprek">
                <di:waypoint x="940" y="170"/>
                <di:waypoint x="990" y="170"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="flow-vervolg-status-plan" id="Edge_flow-vervolg-status-plan">
                <di:waypoint x="1090" y="170"/>
                <di:waypoint x="1140" y="170"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="flow-status-plan-plan-aanmaken" id="Edge_flow-status-plan-plan-aanmaken">
                <di:waypoint x="1240" y="170"/>
                <di:waypoint x="1290" y="170"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="flow-plan-aanmaken-status-afgerond"
                             id="Edge_flow-plan-aanmaken-status-afgerond">
                <di:waypoint x="1390" y="170"/>
                <di:waypoint x="1440" y="170"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="flow-status-afgerond-einde" id="Edge_flow-status-afgerond-einde">
                <di:waypoint x="1540" y="170"/>
                <di:waypoint x="1590" y="170"/>
            </bpmndi:BPMNEdge>
        </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
</bpmn:definitions>
