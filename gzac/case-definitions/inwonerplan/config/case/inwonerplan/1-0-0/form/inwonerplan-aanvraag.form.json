{
    "display": "form",
    "components": [
        {
            "label": "HTML",
            "content": "<h4>Nieuw inwonerplan</h4><p>Start een PDCA-plan voor een inwoner. Het plan zelf wordt in Open Plan aangemaakt via de taak \"Plan aanmaken\" of het tabblad Planoverzicht.</p><p>Demo-bsn's: 111222333 (Erika de Goede), 123456782 (Jan van Dijk), 999990019 (Fatima El Amrani).</p>",
            "refreshOnChange": false,
            "key": "html",
            "type": "htmlelement",
            "input": false,
            "tableView": false
        },
        {
            "label": "BSN",
            "key": "bsn",
            "type": "textfield",
            "input": true,
            "tableView": true,
            "validate": {
                "required": true,
                "pattern": "[0-9]{9}",
                "customMessage": "Voer een geldig bsn van 9 cijfers in"
            }
        },
        {
            "label": "Naam inwoner",
            "key": "naam",
            "type": "textfield",
            "input": true,
            "tableView": true
        },
        {
            "label": "Toelichting",
            "key": "toelichting",
            "type": "textarea",
            "input": true,
            "tableView": false
        },
        {
            "type": "button",
            "label": "Start inwonerplan",
            "key": "submit",
            "disableOnInvalid": true,
            "input": true,
            "tableView": false
        }
    ]
}
