{
    "display": "form",
    "components": [
        {
            "type": "content",
            "key": "info",
            "input": false,
            "tableView": false,
            "html": "<p>Dit instrument staat in het PDCA-plan, met dit dossier als zaakverwijzing. Het plan beheert het niet zelf: rond het hier af of annuleer het hier. De afloop en de toelichting komen op het instrument in het plan te staan.</p>"
        },
        {
            "label": "Instrument",
            "key": "productTitel",
            "type": "textfield",
            "input": true,
            "tableView": false,
            "disabled": true
        },
        {
            "label": "Afloop",
            "key": "instrumentAfloop",
            "type": "radio",
            "input": true,
            "tableView": false,
            "defaultValue": "afgerond",
            "values": [
                { "label": "Afronden", "value": "afgerond" },
                { "label": "Annuleren", "value": "geannuleerd" }
            ],
            "validate": {
                "required": true
            }
        },
        {
            "label": "Resultaat",
            "key": "productResultaat",
            "type": "select",
            "input": true,
            "tableView": false,
            "widget": "html5",
            "defaultValue": "behaald",
            "data": {
                "values": [
                    { "label": "Behaald", "value": "behaald" },
                    { "label": "Gefaald", "value": "gefaald" }
                ]
            },
            "validate": {
                "required": true
            },
            "conditional": {
                "show": true,
                "when": "instrumentAfloop",
                "eq": "afgerond"
            },
            "clearOnHide": false
        },
        {
            "label": "Toelichting",
            "key": "productToelichting",
            "type": "textarea",
            "input": true,
            "tableView": false,
            "defaultValue": "",
            "conditional": {
                "show": true,
                "when": "instrumentAfloop",
                "eq": "afgerond"
            }
        },
        {
            "label": "Reden van annuleren",
            "key": "annuleringsReden",
            "type": "textarea",
            "input": true,
            "tableView": false,
            "defaultValue": "",
            "validate": {
                "required": true
            },
            "conditional": {
                "show": true,
                "when": "instrumentAfloop",
                "eq": "geannuleerd"
            }
        },
        {
            "type": "button",
            "label": "Instrument beëindigen",
            "key": "submit",
            "disableOnInvalid": true,
            "input": true,
            "tableView": false
        }
    ]
}
