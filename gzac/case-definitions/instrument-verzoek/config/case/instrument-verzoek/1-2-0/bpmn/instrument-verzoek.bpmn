<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_instrument_verzoek"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="pdca-app" exporterVersion="0.2.0">
    <!--
      Instrument dossier "instrument-verzoek": the one dossier type for every
      product requested from a PDCA plan, and the one owner of its
      instrument. GZAC's Verzoek plugin creates the dossier from the verzoek
      object the PDCA app filed in the Objecten API (its data IS the dossier
      document: planUuid, doelUuid, subjectId, productTypeUuid,
      productTypeCode, productTitel, productUrn, startStatus, instrumenttype,
      aangevraagdOp) and starts this process on it. The process puts the
      instrument in the plan at once (aanmaak-instrument, result mapping ->
      doc:/instrumentUuid; the dossier itself becomes the instrument's zaak
      reference), lets the behandelaar execute it, and ends it in the plan:
      afgerond with a resultaat, or geannuleerd with a reason
      (update-instrument). All product-specific knowledge comes from the
      verzoek, i.e. from Open Product; this process knows no product.

      The three service tasks that call the PDCA app run asynchronously and
      are retried every minute, five times, before they become an incident on
      the dossier; both plugin actions are safe to repeat. Ending the
      instrument therefore never fails the behandelaar's form submission:
      the task completes, and the instrument's status in the plan follows
      once the job has run.
    -->
    <bpmn:process camunda:versionTag="CD:instrument-verzoek:1.2.0" id="instrument-verzoek"
                  isExecutable="true" name="Instrumentaanvraag">
        <bpmn:startEvent id="start-event" name="Verzoek ontvangen vanuit het plan">
            <bpmn:outgoing>flow-start-aanmaken</bpmn:outgoing>
        </bpmn:startEvent>
        <!-- Asynchronous on purpose: the Verzoek plugin creates the dossier and
             starts this process in one transaction, and aanmaak-instrument
             reads the dossier back through the GZAC API. The job runs once
             that transaction has committed. A failed call is retried every
             minute, five times (aanmaak-instrument is safe to repeat: it
             returns the instrument it created before), then it becomes an
             incident on the dossier. -->
        <bpmn:serviceTask camunda:asyncBefore="true" camunda:expression="${true}" id="instrument-aanmaken"
                          name="Instrument in het plan zetten">
            <bpmn:documentation>Plugin action aanmaak-instrument: creates the instrument under the
                doel in Open Plan (doc:/doelUuid) with the titel, product URN, start status and
                instrumenttype from the verzoek and this dossier as zaak reference; the result
                mapping writes the returned instrumentUuid to doc:/instrumentUuid.
            </bpmn:documentation>
            <bpmn:extensionElements>
                <camunda:failedJobRetryTimeCycle>R5/PT1M</camunda:failedJobRetryTimeCycle>
            </bpmn:extensionElements>
            <bpmn:incoming>flow-start-aanmaken</bpmn:incoming>
            <bpmn:outgoing>flow-aanmaken-uitvoeren</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:userTask camunda:candidateGroups="ROLE_USER" id="instrument-uitvoeren"
                       name="Instrument uitvoeren en beëindigen">
            <bpmn:documentation>Beëindig het instrument met het formulier "instrument-afronden":
                afronden (documentvelden productResultaat + productToelichting) of annuleren
                (documentveld annuleringsReden); de keuze staat in instrumentAfloop.
            </bpmn:documentation>
            <bpmn:incoming>flow-aanmaken-uitvoeren</bpmn:incoming>
            <bpmn:outgoing>flow-uitvoeren-afloop</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:exclusiveGateway id="afloop" name="Afronden of annuleren?" default="flow-afloop-afronden">
            <bpmn:incoming>flow-uitvoeren-afloop</bpmn:incoming>
            <bpmn:outgoing>flow-afloop-afronden</bpmn:outgoing>
            <bpmn:outgoing>flow-afloop-annuleren</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:serviceTask camunda:asyncBefore="true" camunda:expression="${true}" id="instrument-afronden"
                          name="Instrument afronden in het plan">
            <bpmn:documentation>Plugin action update-instrument: sets the instrument
                (doc:/instrumentUuid) to afgerond with resultaat behaald/gefaald from
                doc:/productResultaat; the toelichting goes to the PDCA overlay.
            </bpmn:documentation>
            <bpmn:extensionElements>
                <camunda:failedJobRetryTimeCycle>R5/PT1M</camunda:failedJobRetryTimeCycle>
            </bpmn:extensionElements>
            <bpmn:incoming>flow-afloop-afronden</bpmn:incoming>
            <bpmn:outgoing>flow-afronden-einde</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:serviceTask camunda:asyncBefore="true" camunda:expression="${true}" id="instrument-annuleren"
                          name="Instrument annuleren in het plan">
            <bpmn:documentation>Plugin action update-instrument: sets the instrument
                (doc:/instrumentUuid) to geannuleerd; the reason (doc:/annuleringsReden) goes to the
                PDCA overlay as afbreekreden.
            </bpmn:documentation>
            <bpmn:extensionElements>
                <camunda:failedJobRetryTimeCycle>R5/PT1M</camunda:failedJobRetryTimeCycle>
            </bpmn:extensionElements>
            <bpmn:incoming>flow-afloop-annuleren</bpmn:incoming>
            <bpmn:outgoing>flow-annuleren-einde</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:endEvent id="einde-afgerond" name="Instrument afgerond">
            <bpmn:incoming>flow-afronden-einde</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:endEvent id="einde-geannuleerd" name="Instrument geannuleerd">
            <bpmn:incoming>flow-annuleren-einde</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="flow-start-aanmaken" sourceRef="start-event" targetRef="instrument-aanmaken"/>
        <bpmn:sequenceFlow id="flow-aanmaken-uitvoeren" sourceRef="instrument-aanmaken" targetRef="instrument-uitvoeren"/>
        <bpmn:sequenceFlow id="flow-uitvoeren-afloop" sourceRef="instrument-uitvoeren" targetRef="afloop"/>
        <bpmn:sequenceFlow id="flow-afloop-afronden" name="Afronden" sourceRef="afloop" targetRef="instrument-afronden"/>
        <bpmn:sequenceFlow id="flow-afloop-annuleren" name="Annuleren" sourceRef="afloop" targetRef="instrument-annuleren">
            <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${documentDelegateService.findValueByJsonPointerOrDefault('/instrumentAfloop', execution, 'afgerond') == 'geannuleerd'}</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="flow-afronden-einde" sourceRef="instrument-afronden" targetRef="einde-afgerond"/>
        <bpmn:sequenceFlow id="flow-annuleren-einde" sourceRef="instrument-annuleren" targetRef="einde-geannuleerd"/>
    </bpmn:process>
    <bpmndi:BPMNDiagram id="BPMNDiagram_instrument_verzoek">
        <bpmndi:BPMNPlane bpmnElement="instrument-verzoek" id="BPMNPlane_instrument_verzoek">
            <bpmndi:BPMNShape bpmnElement="start-event" id="Shape_start-event">
                <dc:Bounds height="36" width="36" x="152" y="152"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape bpmnElement="instrument-aanmaken" id="Shape_instrument-aanmaken">
                <dc:Bounds height="80" width="100" x="250" y="130"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape bpmnElement="instrument-uitvoeren" id="Shape_instrument-uitvoeren">
                <dc:Bounds height="80" width="100" x="410" y="130"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape bpmnElement="afloop" id="Shape_afloop" isMarkerVisible="true">
                <dc:Bounds height="50" width="50" x="565" y="145"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape bpmnElement="instrument-afronden" id="Shape_instrument-afronden">
                <dc:Bounds height="80" width="100" x="670" y="130"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape bpmnElement="instrument-annuleren" id="Shape_instrument-annuleren">
                <dc:Bounds height="80" width="100" x="670" y="250"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape bpmnElement="einde-afgerond" id="Shape_einde-afgerond">
                <dc:Bounds height="36" width="36" x="832" y="152"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape bpmnElement="einde-geannuleerd" id="Shape_einde-geannuleerd">
                <dc:Bounds height="36" width="36" x="832" y="272"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNEdge bpmnElement="flow-start-aanmaken" id="Edge_flow-start-aanmaken">
                <di:waypoint x="188" y="170"/>
                <di:waypoint x="250" y="170"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="flow-aanmaken-uitvoeren" id="Edge_flow-aanmaken-uitvoeren">
                <di:waypoint x="350" y="170"/>
                <di:waypoint x="410" y="170"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="flow-uitvoeren-afloop" id="Edge_flow-uitvoeren-afloop">
                <di:waypoint x="510" y="170"/>
                <di:waypoint x="565" y="170"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="flow-afloop-afronden" id="Edge_flow-afloop-afronden">
                <di:waypoint x="615" y="170"/>
                <di:waypoint x="670" y="170"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="flow-afloop-annuleren" id="Edge_flow-afloop-annuleren">
                <di:waypoint x="590" y="195"/>
                <di:waypoint x="590" y="290"/>
                <di:waypoint x="670" y="290"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="flow-afronden-einde" id="Edge_flow-afronden-einde">
                <di:waypoint x="770" y="170"/>
                <di:waypoint x="832" y="170"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="flow-annuleren-einde" id="Edge_flow-annuleren-einde">
                <di:waypoint x="770" y="290"/>
                <di:waypoint x="832" y="290"/>
            </bpmndi:BPMNEdge>
        </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
</bpmn:definitions>
