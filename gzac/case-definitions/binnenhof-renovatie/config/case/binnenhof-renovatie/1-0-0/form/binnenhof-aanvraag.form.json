{
    "display": "form",
    "components": [
        {
            "label": "HTML",
            "content": "<h4>Nieuw renovatieplan (object)</h4><p>Start een PDCA-plan voor een object. Het plan zelf wordt in Open Plan aangemaakt via de taak \"Brandveiligheidsplan aanmaken\" of het tabblad Planoverzicht.</p><p>Demo-objecten: binnenhof-001 (Binnenhof), domtoren-001 (Domtoren), centraal-museum-001 (Centraal Museum).</p>",
            "refreshOnChange": false,
            "key": "html",
            "type": "htmlelement",
            "input": false,
            "tableView": false
        },
        {
            "label": "Object-id",
            "key": "objectId",
            "type": "textfield",
            "input": true,
            "tableView": true,
            "defaultValue": "binnenhof-001",
            "validate": {
                "required": true
            }
        },
        {
            "label": "Objectnaam",
            "key": "objectNaam",
            "type": "textfield",
            "input": true,
            "tableView": true,
            "defaultValue": "Binnenhof"
        },
        {
            "label": "Toelichting",
            "key": "toelichting",
            "type": "textarea",
            "input": true,
            "tableView": false
        },
        {
            "type": "button",
            "label": "Start renovatieplan",
            "key": "submit",
            "disableOnInvalid": true,
            "input": true,
            "tableView": false
        }
    ]
}
