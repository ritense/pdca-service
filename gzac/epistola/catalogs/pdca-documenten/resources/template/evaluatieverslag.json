          "evaluatie": {
            "datum": "4 november 2026",
            "uitgevoerdDoor": "Mark Jansen",
            "deelnemers": "Sanne de Vries, Mark Jansen, Fatima El Amrani (jobcoach)",
            "verslag": "Sanne heeft de afgelopen drie maanden vier dagdelen per week vrijwilligerswerk gedaan bij de kringloopwinkel. Dit gaat goed: zij is er elke afgesproken dag geweest en krijgt positieve feedback van de coördinator.\n\nDe schulden zijn in beeld gebracht en het traject bij de schuldhulpverlening is gestart. Sanne geeft aan dat de rust die dit oplevert haar helpt om zich op werk te richten.\n\nHet doel om in het eerste kwartaal betaald werk te vinden blijkt nog te ambitieus. Samen is afgesproken eerst een werkervaringsplaats van zes maanden te zoeken."
          },
          "wijzigingen": [
            {
              "onderdeel": "Doel: betaald werk",
              "omschrijving": "Termijn verlengd tot 1 juli 2027",
              "toelichting": "Eerst werkervaring opdoen via een werkervaringsplaats"
            },
            {
              "onderdeel": "Instrument: werkervaringsplaats",
              "omschrijving": "Toegevoegd aan het plan",
              "toelichting": "Zes maanden, met begeleiding door de jobcoach"
            },
            {
              "onderdeel": "Instrument: budgetcoaching",
              "omschrijving": "Beëindigd",
              "toelichting": "Vervangen door het traject schuldhulpverlening"
            }
          ],
          "actiepunten": [
            {
              "tekst": "Fatima zoekt voor 1 december twee passende werkervaringsplaatsen."
            },
            {
              "tekst": "Sanne levert de ontbrekende stukken aan bij de schuldhulpverlening."
            }
          ]
        }
      },
